<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">

    <PreferenceCategory android:title="@string/account">
        <Preference
            android:key="trakt_login"
            android:title="@string/trakt_login"
            android:summary="Login to sync your Trakt watchlist and history" />
    </PreferenceCategory>

    <PreferenceCategory android:title="@string/stremio_addons">
        <Preference
            android:key="manage_addons"
            android:title="@string/manage_addons"
            android:summary="View and manage installed Stremio addons" />
        <Preference
            android:key="add_addon"
            android:title="@string/add_addon"
            android:summary="Add a new Stremio addon by URL" />
    </PreferenceCategory>

    <PreferenceCategory android:title="@string/appearance">
        <ListPreference
            android:key="theme"
            android:title="@string/theme"
            android:summary="Choose app theme"
            android:entries="@array/theme_entries"
            android:entryValues="@array/theme_values"
            android:defaultValue="dark" />
        <ListPreference
            android:key="language"
            android:title="@string/language"
            android:summary="Choose app language"
            android:entries="@array/language_entries"
            android:entryValues="@array/language_values"
            android:defaultValue="en" />
    </PreferenceCategory>

    <PreferenceCategory android:title="@string/playback">
        <ListPreference
            android:key="quality"
            android:title="@string/quality"
            android:summary="Choose preferred video quality"
            android:entries="@array/quality_entries"
            android:entryValues="@array/quality_values"
            android:defaultValue="auto" />
        <SwitchPreference
            android:key="subtitles"
            android:title="@string/subtitles"
            android:summary="Enable subtitles when available"
            android:defaultValue="true" />
    </PreferenceCategory>

    <PreferenceCategory android:title="@string/about">
        <Preference
            android:key="version"
            android:title="@string/version"
            android:summary="1.0.0" />
        <Preference
            android:key="licenses"
            android:title="@string/licenses"
            android:summary="Open source licenses" />
    </PreferenceCategory>

</PreferenceScreen>